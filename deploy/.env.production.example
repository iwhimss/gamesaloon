# Prodüksiyon .env dosyası — VDS'de docker-compose.prod.yml ile aynı klasöre
# ".env" adıyla kopyalanır. Gerçek değerlerle doldurulmadan asla commit edilmez.

JWT_SECRET=uzun-ve-rastgele-bir-deger-buraya

POSTGRES_DB=gamesaloon
POSTGRES_USER=gamesaloon
POSTGRES_PASSWORD=guclu-bir-sifre-buraya

# Frontend build sırasında bu adrese göre derlenir — genelde domain + /api gibi
# nginx'in backend'e yönlendirdiği path, ya da doğrudan alt domain.
VITE_BACKEND_URL=https://gamesaloon.fatihdikec.me
